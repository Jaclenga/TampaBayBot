# Default: deterministic cited answers, with no model request or API key.
# To configure optional model assistance, copy this file to ignored .env
# and restart the local dev server. Keep credentials out of version control.
# No database, account or object-storage binding is required.
# Full provider/data-flow/setup notes: docs/LLM.md

LLM_PROVIDER=none
# Allowed: none | ollama | openai-compatible | workers-ai

# Workers AI uses the server-side AI binding (no base URL or API key).
# Set LLM_PROVIDER=workers-ai after configuring the Cloudflare AI binding.
# The default Workers AI model is @cf/meta/llama-3.1-8b-instruct-fp8.
# LLM_MODEL may override it. Generated output defaults to 512 tokens and
# accepts 128-512; a larger cap can increase inference usage.
# See docs/AI_USAGE_LIMITS.md for the shared D1-backed visitor and global
# inference caps. Local mode does not enforce public daily allowances and
# refuses model calls unless the loopback-only development opt-in below is set.
LLM_MAX_OUTPUT_TOKENS=512
# Maximum serialized Workers AI prompt size, in UTF-8 bytes (1024-12000).
LLM_MAX_PROMPT_BYTES=12000

# HTTP providers require an explicit API root and model. Workers AI uses its
# default model when LLM_MODEL is blank and ignores LLM_BASE_URL/LLM_API_KEY.
# Native Ollama example: http://127.0.0.1:11434
# Ollama compatibility example: http://127.0.0.1:11434/v1
# Use your real installed/served model name; no default model is downloaded.
LLM_BASE_URL=
LLM_MODEL=

# Optional server-side bearer credential. Never use NEXT_PUBLIC_ variables.
LLM_API_KEY=

# Deadline range 1000-120000 ms; response limit range 1024-262144 bytes.
LLM_TIMEOUT_MS=30000
LLM_MAX_RESPONSE_BYTES=32768

# Loopback HTTP works without this flag. Set true only for an operator's
# private literal IP over HTTP (RFC1918 IPv4 or IPv6 ULA). Private HTTPS is
# allowed without this flag. Remote public endpoints need HTTPS.
LLM_ALLOW_PRIVATE_HTTP=false

# A hosted worker cannot reach Ollama on a resident's computer via localhost.
# Configure deployed values as runtime bindings/secrets in the host; this
# local file does not change an already deployed site. Never put API keys in
# Vite build values, frontend code, or .openai/hosting.json.
# Ollama cloud models can forward requests even with a localhost URL.
# For local-only models configure Ollama itself (see docs/LLM.md).

# Development: npm run dev -- --port 3001
# Source/GIS settings: data/sources.json and data/gis-config.json
# Pinned records: data/development-config.json
# Ingestion uses --use-system-ca; never disable TLS verification.

# Local development has no shared production database by default.
# Configure the deployed DB binding and server-side secrets through the host;
# never put live values in this example. See docs/OPERATIONS.md.
TAMPABAYBOT_OPERATIONS_MODE=local
# For local development only, with both the app and model endpoint on loopback.
# This does not enforce shared visitor/global AI limits. Never enable it on a
# public server; use a D1 binding and shared operations mode instead.
TAMPABAYBOT_ALLOW_UNMETERED_LOCAL_AI=0
